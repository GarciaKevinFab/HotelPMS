# Vacio a proposito.
#
# frontend/src/lib/api.js hace `process.env.REACT_APP_BACKEND_URL || ''`, asi
# que con esta variable vacia la SPA llama a /api/... con rutas RELATIVAS.
#
# Es lo que corresponde al despliegue del VPS: el mismo contenedor sirve la
# aplicacion y la API bajo https://zenstay.sisac.pe, asi que no hay que
# nombrar el host -- y de paso no hay peticiones entre origenes distintos.
#
# Antes apuntaba a https://confort-inn-api.onrender.com, un backend en Render
# que ya no existe.
REACT_APP_BACKEND_URL=

# CRA trata los warnings como errores en el build de produccion; esto lo apaga.
CI=false
