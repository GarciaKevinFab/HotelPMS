# Ejemplo de variables del backend. Copia a backend/.env.production en el VPS
# (ese archivo NUNCA va a git) y rellena los valores reales.
#
# Este ejemplo cubre las variables del sitio publico. Las de Mercado Pago
# estan explicadas en docs/MERCADOPAGO.md.

# Origen publico del sitio, sin barra final. Se usa en canonical, Open Graph,
# sitemap.xml, robots.txt, llms.txt y en el retorno desde Mercado Pago.
ZENSTAY_URL_PUBLICA=https://zenstay.sisac.pe

# --- Seguridad (auditoria 2026-11-09) ---------------------------------------
# /docs, /redoc y /openapi.json. Apagados si no se define. NUNCA en produccion.
# ZENSTAY_DOCS=1
#
# La CSP sale en modo Content-Security-Policy-Report-Only. Con 1 se aplica de
# verdad; activarla solo cuando la consola del navegador salga limpia.
# ZENSTAY_CSP_APLICAR=1
#
# SOLO PRUEBAS: multiplica todos los limites de peticiones (backend/limites.py).
# No se define en produccion.
# ZENSTAY_LIMITES_PRUEBAS=1000

# --- Facturacion electronica: motor propio (backend/facturacion_propia.py) ---
# APAGADO si falta la URL o el token: los comprobantes quedan como internos
# (DRAFT, sin validez tributaria). No activar hasta que el motor
# facturacion-sunat este en produccion y emita lo que un hotel necesita
# (boletas, PDF, RUC de cada hotel). Requiere el "si" de Kevin.
# FACTURACION_URL=http://127.0.0.1:8090
# FACTURACION_TOKEN=
# RUC con cuyas credenciales esta configurado el motor; un hotel con otro RUC
# recibe "no disponible todavia" sin que se llame al motor.
# FACTURACION_EMISOR_RUC=
