# Ejemplo de variables del backend. Copia a backend/.env.production en el VPS
# (ese archivo NUNCA va a git) y rellena los valores reales.
#
# Este ejemplo cubre las variables del sitio publico. Las de Mercado Pago
# estan explicadas en docs/MERCADOPAGO.md.

# Origen publico del sitio, sin barra final. Se usa en canonical, Open Graph,
# sitemap.xml, robots.txt, llms.txt y en el retorno desde Mercado Pago.
ZENSTAY_URL_PUBLICA=https://zenstay.sisac.pe

# WhatsApp de ventas: 51 + los 9 digitos del celular, sin "+" ni espacios
# (formato 51XXXXXXXXX). Activa el boton "Escribenos por WhatsApp" en la
# portada, /precios y /comprar, el boton flotante y los enlaces de cotizacion y
# demo. Vacia o mal escrita: NO se muestra ningun WhatsApp y la cotizacion y la
# demo van a soporte@sisac.pe. Ver docs/SITIO_PUBLICO.md.
WHATSAPP_VENTAS=
